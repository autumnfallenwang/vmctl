# Test-host credentials for the vmctl IG lab.
#
# Copy to creds.env (which is gitignored) and set a real password, then source it
# before bringing the VMs up:
#
#   cp creds.env.example creds.env
#   # edit creds.env, set VMCTL_SSH_PASSWORD
#   set -a; source creds.env; set +a
#   vagrant up
#
# These are TEST credentials for an isolated NAT lab only. vmctl does not manage
# secrets — real deployments supply and rotate their own (see ADR 0002).

VMCTL_SSH_USER=vmctl
VMCTL_SSH_PASSWORD=change-me-in-creds-env
